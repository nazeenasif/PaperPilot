# Copy to .env and edit. All values below are the defaults.

# Target passage size in words.
CHUNK_WORDS=220
# Words carried over from the previous passage in the same section (must be < CHUNK_WORDS).
CHUNK_OVERLAP=40
# Final leftover passages shorter than this are dropped (must be < CHUNK_WORDS).
MIN_CHUNK_WORDS=30
# Number of passages a search returns by default.
TOP_K=6
# Folder for the persistent paper library (gitignored).
LIBRARY_DIR=data/library
# Local embedding model.
EMBED_MODEL=BAAI/bge-small-en-v1.5
