# Copy to .env and edit. All values below are the defaults.

# Target passage size in words.
CHUNK_WORDS=220
# Words carried over from the previous passage in the same section (must be < CHUNK_WORDS).
CHUNK_OVERLAP=40
# Final leftover passages shorter than this are dropped (must be < CHUNK_WORDS).
MIN_CHUNK_WORDS=30
# Number of passages a search returns by default.
TOP_K=6
# Folder for the persistent paper library (gitignored).
LIBRARY_DIR=data/library
# Local embedding model.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Language model: any OpenAI-compatible provider. Defaults: OpenRouter + a pinned free model.
# Free models: 20 requests/minute, 50/day (1,000/day after $10 of lifetime credits).
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# Your key from https://openrouter.ai/keys. Never commit a real key.
LLM_API_KEY=your-key-here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Alternative free model, kept for a later model-comparison experiment:
# LLM_MODEL=google/gemma-4-31b-it:free
# Optional: cap model reasoning (e.g. low, none) if answers are cut off.
LLM_REASONING_EFFORT=
# Per-request time limit in seconds; slow requests are retried, then reported as an error.
LLM_TIMEOUT_SECONDS=60
# Passages scoring below this (0-1) are not sent to the model. Calibrated for bge-small on the
# test library (scripts/calibrate_threshold.py): never reject on-topic questions; rejecting
# near-miss off-topic questions is best effort. Recalibrate if the model, chunking or papers change.
RELEVANCE_THRESHOLD=0.58
